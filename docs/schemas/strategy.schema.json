{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/xuyinzhang123/StrategyToVideo-OSS/blob/main/docs/schemas/strategy.schema.json",
  "title": "StrategyToVideo strategy card",
  "description": "策略卡契约 Draft 1，见 docs/STRATEGY_SPEC.md",
  "type": "object",
  "required": ["schemaVersion", "id", "symbol", "range", "data", "params"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "id": { "enum": ["macd_cross", "close_buy_open_sell"] },
    "name": { "type": "string", "maxLength": 60 },
    "symbol": { "type": "string", "pattern": "^[0-9]{6}$" },
    "nameOfSecurity": { "type": "string", "maxLength": 60 },
    "range": {
      "type": "object",
      "required": ["start", "end"],
      "additionalProperties": false,
      "properties": {
        "start": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "end": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "warmupBars": { "type": "integer", "minimum": 0, "maximum": 2000 },
        "warmupMode": { "const": "prepend" }
      }
    },
    "data": {
      "type": "object",
      "required": ["adjust"],
      "additionalProperties": false,
      "properties": {
        "adjust": { "const": "none" },
        "dividendPolicy": { "enum": ["provided", "ignored"] },
        "source": { "type": "string", "maxLength": 60 },
        "sourceSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "params": {
      "type": "object",
      "description": "由 id 对应模板定义；此处只做类型约束，具体校验在引擎内按模板执行",
      "properties": {
        "fast": { "type": "integer", "minimum": 2 },
        "slow": { "type": "integer", "minimum": 3 },
        "signal": { "type": "integer", "minimum": 2 },
        "entrySignal": { "enum": ["macd_golden"] },
        "composition": {
          "type": "object",
          "description": "V0.3 可组合策略，仅 close_buy_open_sell 模板使用；旧卡无此字段",
          "additionalProperties": false,
          "required": ["schema", "entry", "exits"],
          "properties": {
            "schema": { "const": "stv.composition/0.1" },
            "entry": {
              "type": "object", "additionalProperties": false,
              "required": ["type"],
              "description": "单个原子条件 {type:maCross|breakout}，或多条件与 {type:'all', items:[...]}（同日全部成立才入场）",
              "properties": {
                "type": { "enum": ["maCross", "breakout", "all"] },
                "params": { "type": "object" },
                "items": {
                  "type": "array", "minItems": 2, "maxItems": 3,
                  "items": {
                    "type": "object", "additionalProperties": false,
                    "required": ["type"],
                    "properties": {
                      "type": { "enum": ["maCross", "breakout"] },
                      "params": { "type": "object" }
                    }
                  }
                }
              }
            },
            "exits": {
              "type": "array", "minItems": 1, "maxItems": 3,
              "items": {
                "type": "object", "additionalProperties": false,
                "required": ["type"],
                "properties": {
                  "type": { "enum": ["maCross", "fixedHolding", "returnThreshold", "trailingStop"] },
                  "params": { "type": "object" }
                }
              }
            }
          }
        },
        "entryFill": { "enum": ["sameClose", "nextOpen"] },
        "exitFill": { "enum": ["sameClose", "nextOpen"] },
        "auctionFilter": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "basis": { "const": "open_gap_pct" },
            "holdIfGte": { "type": "number" },
            "else": { "const": "sellAtOpen" }
          },
          "required": ["basis", "else"]
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entryFill": { "enum": ["sameClose", "nextOpen"] },
        "exitFill": { "enum": ["sameClose", "nextOpen"] },
        "sealedLimitBlocks": { "type": "boolean" },
        "lotSize": { "type": "integer", "enum": [100] },
        "initialCapital": { "type": "number", "minimum": 10000 }
      }
    },
    "benchmark": { "const": "hold" },
    "reproducibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "engineVersion": { "type": "string" },
        "inputSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
