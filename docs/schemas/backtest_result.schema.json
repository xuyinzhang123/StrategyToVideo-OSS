{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/xuyinzhang123/StrategyToVideo-OSS/blob/main/docs/schemas/backtest_result.schema.json",
  "title": "StrategyToVideo unified backtest result",
  "description": "统一回测结果契约 Draft 1；渲染器只读本结构，见 docs/STRATEGY_SPEC.md §3",
  "type": "object",
  "required": ["schemaVersion", "strategy", "state", "signals", "trades", "equity", "decisions", "metrics", "reproducibility"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "strategy": { "type": "object", "description": "策略卡原样" },
    "state": {
      "type": "object",
      "required": ["start", "end", "bars", "readyFrom"],
      "properties": {
        "start": { "type": "string" },
        "end": { "type": "string" },
        "bars": { "type": "integer", "minimum": 0 },
        "warmupBars": { "type": "integer", "minimum": 0 },
        "readyFrom": { "type": "integer", "minimum": 0 },
        "warnings": { "type": "array", "items": { "type": "string" } }
      }
    },
    "market": {
      "type": "array",
      "description": "展示区间的行情序列，供渲染器画价格与买卖点；不参与回测计算",
      "items": {
        "type": "object",
        "required": ["date", "open", "high", "low", "close"],
        "additionalProperties": false,
        "properties": {
          "date": { "type": "string" },
          "open": { "type": "number" },
          "high": { "type": "number" },
          "low": { "type": "number" },
          "close": { "type": "number" },
          "volume": { "type": "number" }
        }
      }
    },
    "signals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "type", "execDate", "execPrice", "executed"],
        "properties": {
          "date": { "type": "string" },
          "type": { "enum": ["GOLDEN", "DEATH", "ENTRY", "EXIT"] },
          "indicators": { "type": "object" },
          "execDate": { "type": "string" },
          "execPrice": { "type": "number" },
          "executed": { "type": "boolean" },
          "blocked": { "type": "boolean" },
          "note": { "type": "string" }
        }
      }
    },
    "trades": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["seq", "side", "date", "price", "shares", "amount", "fee"],
        "properties": {
          "seq": { "type": "integer" },
          "side": { "enum": ["BUY", "SELL"] },
          "date": { "type": "string" },
          "price": { "type": "number" },
          "shares": { "type": "integer" },
          "amount": { "type": "number" },
          "fee": { "type": "number" },
          "feeBreakdown": { "type": "object" },
          "commission": { "type": "number" },
          "stampDuty": { "type": "number" },
          "transferFee": { "type": "number" },
          "dividendTax": { "type": "number" },
          "holdingDays": { "type": ["integer", "null"] },
          "signalType": { "type": "string" },
          "signalDate": { "type": "string" }
        }
      }
    },
    "equity": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "asset"],
        "properties": {
          "date": { "type": "string" },
          "cash": { "type": "number" },
          "shares": { "type": "number" },
          "holdingValue": { "type": "number" },
          "divReceivable": { "type": "number" },
          "asset": { "type": "number" },
          "drawdown": { "type": "number" },
          "flags": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "kind", "action"],
        "properties": {
          "date": { "type": "string" },
          "kind": { "enum": ["ENTRY", "EXIT", "HOLD"] },
          "reason": { "type": "string" },
          "openGapPct": { "type": ["number", "null"] },
          "action": { "type": "string" }
        }
      }
    },
    "metrics": {
      "type": "object",
      "required": ["final", "totalReturn", "maxDD", "tradeCount", "totalFees"],
      "properties": {
        "final": { "type": "number" },
        "totalReturn": { "type": "number" },
        "cagr": { "type": "number" },
        "maxDD": { "type": "number" },
        "tradeCount": { "type": "integer" },
        "goldenCount": { "type": "integer" },
        "deathCount": { "type": "integer" },
        "totalFees": { "type": "number" },
        "totalDividendTax": { "type": "number" },
        "feeBreakdown": { "type": "object" },
        "benchmark": {
          "type": "object",
          "properties": { "id": { "type": "string" }, "final": { "type": "number" } }
        }
      }
    },
    "reproducibility": {
      "type": "object",
      "required": ["engineVersion", "resultSha256"],
      "properties": {
        "engineVersion": { "type": "string" },
        "resultSha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
