{
  "name": "strategy-to-video-oss-v01",
  "version": "0.3.0",
  "private": true,
  "description": "Strategy to Video Open Source — 本地优先的策略可视化与视频生成工具：MACD 演示（SIMULATED）+ 用户 CSV 导入（V0.2）+ 策略卡自动取数/回测/视频（V0.3）",
  "license": "MIT",
  "scripts": {
    "start": "node web/server.js",
    "gen:demo": "node tools/gen_demo_data.cjs",
    "check:samples": "node tools/check_samples.cjs",
    "check:determinism": "node tools/check_determinism.cjs",
    "check:api": "node tools/check_api_contract.cjs",
    "check:card": "node tools/check_strategy_card_api.cjs",
    "check:nl": "node engine_next/tests/verify_nl_parser.cjs",
    "check:nl-preview": "node tools/check_nl_preview.cjs",
    "check:accept": "python engine_next/tests/accept_strategy_video.py --run strategy_600000_A",
    "check:accept:neg": "python tools/check_accept_negative.py",
    "e2e:card": "node tools/e2e_strategy_card_web.cjs"
  },
  "engines": {
    "node": ">=18"
  }
}
